-- Pick a random element from an array/table

-- an array of string(text) values
bojanglesSides = {"Bo Rounds.","Fries.","Sweet Tea."}
myText = "I want a 4 piece supreme dinner with "
myfontSize = 1

require("L5")

function setup()
    size(600, 400)
    angleMode(DEGREES)
    frameRate(60)

    describe('Black background with white text.')

    background(0)
    textAlign(CENTER)
    textSize(20)
    -- using random and the array name to get a random element from the array
    sentenceBuilder(20)
end

function draw()
  -- pick a new random element and draw it every 2 seconds (60 frames per second times 2)
  if frameCount%120 == 0 then
    background(0)
    sentenceBuilder(myfontSize)
    myfontSize = myfontSize 
    
  end
end

function sentenceBuilder(fontSize)
  textSize(fontSize)
  text(myText..random(bojanglesSides), width/2, height/2)
  text("Thank You!",width/2, height*0.6)
end